# Copy to .env and fill in. .env is git-ignored. Restart the service after a change:
#   .venv/bin/python -m tender_radar install-service

# AI fit scoring, bid analysis and translation fallback (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Email alerts: the SMTP password for alerts.email.username in config.json
TENDER_RADAR_SMTP_PASSWORD=

# Telegram alerts: token from @BotFather; set alerts.telegram.chat_id in config.json
TENDER_RADAR_TELEGRAM_TOKEN=

# Required only when server.host in config.json is not 127.0.0.1 (shared server)
TENDER_RADAR_PASSWORD=
